---
/* WFM Records list mock, used in the page hero: Record, Title, Template, Stage, Status, Due, Agent. */
import AppWindow from '../mock/AppWindow.astro';
import { wfmRecords } from '../../data/demo';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class:list={[cls]}>
  <AppWindow title="Workflow Manager" activeNav="Quality" tabs={['Records', 'Templates', 'Archives']} activeTab={0}>
    <div class="rl-toolbar" aria-hidden="true">
      <span class="rl-section">Records in View ({wfmRecords.length})</span>
      <span class="mock-btn mock-btn-green ml-auto">New Record</span>
    </div>
    <div class="rl-table" aria-hidden="true">
      <div class="rl-row rl-head">
        <span>Record</span><span>Title</span><span class="hidden md:block">Template</span><span>Stage</span><span>Status</span><span class="hidden lg:block">Due</span><span class="hidden sm:block">Agent</span>
      </div>
      {wfmRecords.map((r) => (
        <div class="rl-row">
          <span class="tnum">{r.code}</span>
          <span class="truncate text-ink">{r.title}</span>
          <span class="hidden md:block truncate">{r.template}</span>
          <span class="tnum">{r.stage}</span>
          <span><span class={`pill pill-${r.tone}`}>{r.status}</span></span>
          <span class="hidden lg:block tnum">{r.due}</span>
          <span class="hidden sm:block truncate">{r.agent}</span>
        </div>
      ))}
    </div>
  </AppWindow>
</div>

<style>
  .rl-toolbar { display: flex; align-items: center; margin-bottom: 12px; }
  .rl-section { font-size: 12px; font-weight: 600; color: var(--color-ink); }
  .mock-btn { display: inline-flex; align-items: center; height: 28px; padding: 0 12px; border-radius: 6px; border: 1px solid var(--color-line); background: #fff; font-size: 11.5px; font-weight: 500; color: var(--color-muted); }
  .mock-btn-green { background: var(--color-green); border-color: var(--color-green); color: #fff; font-weight: 600; }
  .rl-table { border: 1px solid var(--color-line); border-radius: 8px; overflow-x: auto; background: #fff; font-size: 11.5px; }
  /* Visible columns per breakpoint must match the number of un-hidden <span>s in the markup:
     Record, Title, [Template md+], Stage, Status, [Due lg+], [Agent sm+]. Status carries the
     longest pill label ("Awaiting Verification"), so it gets a fixed, generous track. */
  .rl-row { display: grid; grid-template-columns: 92px minmax(160px, 2.2fr) 40px 172px; align-items: center; gap: 12px; height: 38px; padding: 0 12px; border-top: 1px solid #ebebea; color: var(--color-muted); min-width: max-content; }
  .rl-row:first-child { border-top: 0; }
  @media (min-width: 640px) { .rl-row { grid-template-columns: 92px minmax(160px, 2.2fr) 40px 172px minmax(0, 1fr); } }
  @media (min-width: 768px) { .rl-row { grid-template-columns: 92px minmax(160px, 2.2fr) minmax(0, 1fr) 40px 172px minmax(0, 1fr); } }
  @media (min-width: 1024px) { .rl-row { grid-template-columns: 92px minmax(0, 2.2fr) minmax(0, 1fr) 40px 172px 96px minmax(0, 1fr); min-width: 0; } }
  .rl-head { height: 32px; background: var(--color-surface-2); font-size: 9.5px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
</style>
