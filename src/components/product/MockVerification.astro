---
/* Effectiveness verification: Mark Effective / Mark Ineffective outcomes on a closed record. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class:list={['ver-card', cls]} aria-hidden="true">
  <div class="ver-head">
    <p class="ver-title">Effectiveness verification</p>
    <span class="pill pill-blue">Awaiting Verification</span>
  </div>
  <p class="ver-hint">Verification due 27.12.2026 &mdash; static, 3 months after closure.</p>
  <div class="ver-actions">
    <span class="ver-btn ver-btn-green">Mark Effective</span>
    <span class="ver-btn ver-btn-red">Mark Ineffective</span>
  </div>
</div>

<style>
  .ver-card { border-radius: 16px; background: var(--color-surface); border: 1px solid var(--color-line); box-shadow: var(--shadow-lift); padding: 20px 22px 22px; }
  .ver-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .ver-title { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--color-ink); }
  .ver-hint { margin-top: 8px; font-size: 12px; color: var(--color-muted); }
  .ver-actions { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--color-line); display: flex; gap: 8px; }
  .ver-btn { display: inline-flex; align-items: center; justify-content: center; height: 34px; padding: 0 16px; border-radius: 7px; font-size: 12.5px; font-weight: 600; border: 1px solid transparent; }
  .ver-btn-green { background: var(--color-green-bg); color: var(--color-green); border-color: var(--color-green-border); }
  .ver-btn-red { background: var(--color-red-bg); color: var(--color-red-text); border-color: var(--color-red-border); }
</style>
