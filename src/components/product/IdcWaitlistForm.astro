---
/* Waitlist form: email + "Join the waitlist". Sends through src/scripts/lead.ts
   (Web3Forms when configured, otherwise the email/Gmail/Outlook/copy fallback). No dates promised. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<form class:list={['wl-form', cls]} data-idc-waitlist novalidate>
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <label class="wl-label" for="idc-waitlist-email">Work email</label>
  <div class="wl-row">
    <input
      id="idc-waitlist-email"
      name="email"
      type="email"
      inputmode="email"
      autocomplete="email"
      required
      placeholder="you@company.com"
      class="wl-input"
    />
    <button type="submit" class="btn btn-primary">Join the waitlist</button>
  </div>
  <p class="wl-note" data-idc-waitlist-note role="status" aria-live="polite"></p>
  <div class="lead-fb" data-idc-waitlist-fb hidden></div>
</form>

<style>
  .wl-form { max-width: 30rem; }
  .wl-label { display: block; font-size: 13px; color: var(--color-muted); margin-bottom: 8px; }
  .wl-row { display: flex; flex-wrap: wrap; gap: 10px; }
  .wl-input { flex: 1; min-width: 12rem; height: 44px; padding: 0 14px; border-radius: 10px; border: 1px solid var(--color-line); background: var(--color-surface); font-size: 16px; color: var(--color-ink); }
  .wl-input:focus-visible { outline: 2px solid var(--color-green); outline-offset: 2px; }
  .wl-note { margin-top: 10px; font-size: 13px; color: var(--color-muted); min-height: 1.2em; }
</style>

<script>
  import { wireWaitlist } from '../../scripts/lead';
  const form = document.querySelector<HTMLFormElement>('[data-idc-waitlist]');
  if (form) wireWaitlist(form, form.querySelector('[data-idc-waitlist-note]'), form.querySelector('[data-idc-waitlist-fb]'));
</script>
