---
/* "What auditors see": the audit trail, rendered in the app's own format —
   bold actor, action, optional ": detail", then a YYYY-MM-DD HH:MM line. Downloadable as PDF. */
import { auditTrail } from '../../data/demo';
interface Props { class?: string; limit?: number }
const { class: cls = '', limit = auditTrail.length } = Astro.props;
const rows = auditTrail.slice(0, limit);
---
<div class:list={['audit-card', cls]} aria-hidden="true">
  <div class="audit-head">
    <p class="audit-title">Audit trail</p>
    <span class="audit-pdf">Download as PDF</span>
  </div>
  <ul class="audit-list">
    {rows.map((r) => (
      <li class="audit-row">
        <span class="audit-dot"></span>
        <div class="audit-text">
          <p><b>{r.actor}</b> {r.action}{r.detail && <>: {r.detail}</>}</p>
          <p class="audit-at tnum">{r.at}</p>
        </div>
      </li>
    ))}
  </ul>
</div>

<style>
  .audit-card { border-radius: 16px; background: var(--color-surface); border: 1px solid var(--color-line); box-shadow: var(--shadow-lift); padding: 18px 20px 6px; }
  .audit-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid var(--color-line); }
  .audit-title { font-family: var(--font-display); font-weight: 700; font-size: 15px; color: var(--color-ink); }
  .audit-pdf { font-size: 11.5px; color: var(--color-muted); border: 1px solid var(--color-line); border-radius: 6px; padding: 5px 10px; }
  .audit-list { padding: 6px 0 12px; }
  .audit-row { display: flex; gap: 10px; padding: 9px 0; }
  .audit-dot { margin-top: 6px; width: 6px; height: 6px; border-radius: 999px; background: var(--color-dim); flex-shrink: 0; }
  .audit-text p:first-child { font-size: 12.5px; color: var(--color-ink); line-height: 1.5; }
  .audit-at { margin-top: 2px; font-size: 11px; color: var(--color-dim); }
</style>
