---
/* WFM record-detail view: black meta strip (code, template, title, stage, owner/agent, due,
   status) + tab strip (Record details / Audit trail / Workflow / Report). */
import { wfmRecords, auditTrail } from '../../data/demo';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const record = wfmRecords[0];
---
<div class:list={['rd-window', cls]} aria-hidden="true">
  <div class="rd-strip">
    <div class="rd-strip-top">
      <span class="rd-code tnum">{record.code}</span>
      <span class="rd-sep" aria-hidden="true"></span>
      <span class="rd-template">{record.template}</span>
      <span class={`pill pill-${record.tone} ml-auto`}>{record.status}</span>
    </div>
    <p class="rd-title">{record.title}</p>
    <div class="rd-meta">
      <span><span class="rd-meta-label">Stage</span> {record.stage.replace('/', ' of ')}</span>
      <span><span class="rd-meta-label">Owner</span> {record.createdBy}</span>
      <span><span class="rd-meta-label">Agent</span> {record.agent}</span>
      <span><span class="rd-meta-label">Due</span> <span class="tnum">{record.due}</span></span>
    </div>
  </div>
  <div class="rd-tabs">
    <span class="rd-tab on">Record details</span>
    <span class="rd-tab">Audit trail ({auditTrail.length})</span>
    <span class="rd-tab">Workflow</span>
    <span class="rd-tab">Report</span>
  </div>
  <div class="rd-body">
    <div class="rd-progress">
      {['Report & Record', 'Immediate Correction', 'Investigation & Severity Assessment', 'Root Cause Analysis', 'Corrective & Preventive Action', 'Verification'].map((s, i) => (
        <div class="rd-step">
          <span class:list={['rd-bubble', { done: i < 2, current: i === 2 }]}>{i < 2 ? '✓' : i + 1}</span>
          <span class="rd-step-name">{s}</span>
        </div>
      ))}
    </div>
    <div class="rd-entry">
      <p class="rd-entry-label">Investigation &amp; Severity Assessment</p>
      <p class="rd-entry-body">48 cartons quarantined at dispatch pending investigation. Severity to be rated after supplier COA review.</p>
    </div>
  </div>
</div>

<style>
  .rd-window { border-radius: 14px; overflow: hidden; border: 1px solid var(--color-line); box-shadow: var(--shadow-window); background: var(--color-surface); }
  .rd-strip { background: var(--color-night); color: var(--color-night-fg); padding: 16px 18px; }
  .rd-strip-top { display: flex; align-items: center; gap: 10px; font-size: 11.5px; color: var(--color-night-muted); }
  .rd-code { font-weight: 600; color: var(--color-night-fg); }
  .rd-sep { width: 1px; height: 12px; background: var(--color-night-line); }
  .rd-title { margin-top: 8px; font-family: var(--font-display); font-weight: 700; font-size: 17px; letter-spacing: -0.015em; }
  .rd-meta { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 16px; font-size: 12px; color: var(--color-night-muted); }
  .rd-meta-label { color: #6c6c64; margin-right: 4px; }
  .rd-tabs { display: flex; gap: 2px; padding: 0 18px; border-bottom: 1px solid var(--color-line); background: var(--color-surface); font-size: 12px; }
  .rd-tab { padding: 11px 4px; margin-right: 18px; color: var(--color-muted); position: relative; }
  .rd-tab.on { color: var(--color-ink); font-weight: 600; }
  .rd-tab.on::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; background: var(--color-ink); }
  .rd-body { padding: 18px; }
  .rd-progress { display: flex; align-items: flex-start; gap: 4px; overflow-x: auto; padding-bottom: 4px; }
  .rd-step { display: flex; flex-direction: column; align-items: center; gap: 6px; width: 84px; flex-shrink: 0; text-align: center; }
  .rd-bubble { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 999px; border: 1.5px solid var(--color-line); color: var(--color-dim); font-size: 10.5px; font-weight: 700; }
  .rd-bubble.done { background: var(--color-green); border-color: var(--color-green); color: #fff; }
  .rd-bubble.current { border-color: var(--color-ink); color: var(--color-ink); box-shadow: 0 0 0 3px rgb(17 17 16 / 0.08); }
  .rd-step-name { font-size: 10px; color: var(--color-muted); line-height: 1.3; }
  .rd-entry { margin-top: 18px; padding: 14px 16px; border: 1px solid var(--color-line); border-radius: 10px; background: var(--color-surface-2); }
  .rd-entry-label { font-size: 11.5px; font-weight: 600; color: var(--color-ink); }
  .rd-entry-body { margin-top: 6px; font-size: 12px; color: var(--color-muted); line-height: 1.55; }
</style>
