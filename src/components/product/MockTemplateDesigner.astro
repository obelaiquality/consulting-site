---
/*
 * Signature scroll moment for the WFM page: the template designer. Stage list with drag
 * handles + up/down, a stage editor on the right, and a live-preview step track at the
 * bottom. The DOM already renders the settled (post-drag) order — "Root Cause Analysis"
 * moved from position 4 to position 2. With motion allowed, the script offsets the moved
 * cards back to their "before" position on load, then animates them into place once the
 * section scrolls into view. Reduced motion (or no JS) shows the settled order directly.
 */
import AppWindow from '../mock/AppWindow.astro';
interface Props { class?: string }
const { class: cls = '' } = Astro.props;

const stages = [
  { name: 'Report & Record', origin: 1 },
  { name: 'Root Cause Analysis', origin: 4, dragged: true },
  { name: 'Immediate Correction', origin: 2, shifted: true },
  { name: 'Investigation & Severity Assessment', origin: 3, shifted: true, approval: true },
  { name: 'Corrective & Preventive Action', origin: 5, approval: true, active: true },
  { name: 'Verification', origin: 6 },
];
---
<div class:list={[cls]}>
  <AppWindow title="Nonconformance" eyebrow="Template Designer" tabs={['Stages', 'Custom Fields', 'Approvals', 'Versioning']} activeTab={0}>
    <div class="td-grid" data-template-designer>
      <div class="td-list" data-stage-list aria-hidden="true">
        {stages.map((s, i) => (
          <div
            class:list={['stage-card', { active: s.active }]}
            data-stage-dragged={s.dragged ? '' : undefined}
            data-stage-shifted={s.shifted ? '' : undefined}
          >
            <span class="stage-handle">⋮⋮</span>
            <span class="stage-pos tnum">{i + 1}</span>
            <span class="stage-name truncate">{s.name}</span>
            {s.approval && <span class="pill pill-blue">Approval</span>}
            <span class="stage-arrows">
              <span class="stage-arrow">↑</span>
              <span class="stage-arrow">↓</span>
            </span>
          </div>
        ))}
      </div>

      <div class="td-editor" aria-hidden="true">
        <p class="ed-label">Editing &mdash; Corrective &amp; Preventive Action</p>
        <label class="ed-field">
          <span class="ed-field-label">Stage instructions</span>
          <span class="ed-textarea">Define and implement corrective and preventive actions. Attach evidence of implementation before advancing.</span>
        </label>
        <div class="ed-row">
          <label class="ed-field">
            <span class="ed-field-label">Stage deadline</span>
            <span class="ed-inline"><span class="ed-input tnum">10</span><span class="ed-select">days</span></span>
          </label>
        </div>
        <label class="ed-checkbox">
          <span class="ed-check ed-check-on"></span>
          Requires approval before stage advances
        </label>
        <div class="ed-field">
          <span class="ed-field-label">Approver job title</span>
          <div class="ed-chips">
            <span class="ed-chip">Quality Manager</span>
          </div>
        </div>
      </div>

      <div class="td-preview" data-stage-preview>
        <p class="preview-label">Live preview</p>
        <div class="preview-track">
          {stages.map((s, i) => (
            <div class="preview-step">
              <span class:list={['preview-bubble', { on: i === 0, current: s.active }]}>{i === 0 ? '✓' : i + 1}</span>
              {i < stages.length - 1 && <span class="preview-line"></span>}
            </div>
          ))}
        </div>
      </div>
    </div>
  </AppWindow>
</div>

<style>
  .td-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .td-grid { grid-template-columns: 1.05fr 1fr; } }
  .td-list { display: flex; flex-direction: column; gap: 6px; }
  .stage-card { position: relative; display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 10px; border: 1px solid var(--color-line); border-radius: 9px; background: #fff; font-size: 12.5px; will-change: transform; }
  .stage-card.active { border-color: var(--color-ink); box-shadow: 0 0 0 1px var(--color-ink); }
  .stage-handle { color: var(--color-dim); font-size: 12px; letter-spacing: -1px; cursor: grab; }
  .stage-pos { width: 16px; color: var(--color-muted); font-weight: 600; }
  .stage-name { flex: 1; font-weight: 500; color: var(--color-ink); }
  .stage-arrows { display: flex; flex-direction: column; gap: 1px; color: var(--color-dim); font-size: 9px; line-height: 1; }

  .td-editor { border: 1px solid var(--color-line); border-radius: 12px; background: #fff; padding: 16px; display: flex; flex-direction: column; gap: 14px; }
  .ed-label { font-size: 12px; font-weight: 600; color: var(--color-ink); }
  .ed-field { display: flex; flex-direction: column; gap: 6px; }
  .ed-field-label { font-size: 11px; color: var(--color-muted); }
  .ed-textarea { display: block; min-height: 52px; padding: 8px 10px; border: 1px solid var(--color-line); border-radius: 7px; background: var(--color-surface-2); font-size: 11.5px; color: var(--color-muted); line-height: 1.5; }
  .ed-row { display: flex; gap: 10px; }
  .ed-inline { display: flex; gap: 6px; }
  .ed-input, .ed-select { height: 30px; padding: 0 10px; border: 1px solid var(--color-line); border-radius: 6px; display: inline-flex; align-items: center; font-size: 12px; color: var(--color-ink); background: #fff; }
  .ed-checkbox { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--color-ink); font-weight: 500; }
  .ed-check { width: 15px; height: 15px; border-radius: 4px; border: 1.5px solid var(--color-line); }
  .ed-check-on { background: var(--color-ink); border-color: var(--color-ink); position: relative; }
  .ed-check-on::after { content: ''; position: absolute; left: 4px; top: 1px; width: 4px; height: 8px; border: solid #fff; border-width: 0 1.5px 1.5px 0; transform: rotate(40deg); }
  .ed-chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .ed-chip { display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 999px; background: var(--color-surface-2); border: 1px solid var(--color-line); font-size: 11px; color: var(--color-ink); }

  .td-preview { grid-column: 1 / -1; margin-top: 4px; padding-top: 14px; border-top: 1px solid var(--color-line); transition: opacity 0.4s var(--ease-out); }
  .preview-label { font-size: 11px; color: var(--color-muted); margin-bottom: 10px; }
  .preview-track { display: flex; align-items: center; }
  .preview-step { display: flex; align-items: center; flex: 1; }
  .preview-step:last-child { flex: 0; }
  .preview-bubble { display: grid; place-items: center; flex-shrink: 0; width: 24px; height: 24px; border-radius: 999px; border: 1.5px solid var(--color-line); color: var(--color-dim); font-size: 10.5px; font-weight: 700; }
  .preview-bubble.on { background: var(--color-green); border-color: var(--color-green); color: #fff; }
  .preview-bubble.current { border-color: var(--color-ink); color: var(--color-ink); box-shadow: 0 0 0 3px rgb(17 17 16 / 0.08); }
  .preview-line { flex: 1; height: 1.5px; background: var(--color-line); margin: 0 4px; }
</style>

<script>
  import { onReady, gsap, ScrollTrigger, reduced } from '../../scripts/motion';

  onReady(() => {
    const root = document.querySelector<HTMLElement>('[data-template-designer]');
    if (reduced || !root) return;

    const list = root.querySelector<HTMLElement>('[data-stage-list]');
    const preview = root.querySelector<HTMLElement>('[data-stage-preview]');
    const dragged = root.querySelector<HTMLElement>('[data-stage-dragged]');
    const shifted = Array.from(root.querySelectorAll<HTMLElement>('[data-stage-shifted]'));
    if (!list || !dragged || !shifted.length) return;

    const cards = Array.from(list.children) as HTMLElement[];
    if (cards.length < 2) return;
    const rowPitch = cards[1].offsetTop - cards[0].offsetTop;

    // Start in the "before drag" arrangement: the moved card sits two rows lower,
    // the two cards it will land above sit one row higher.
    gsap.set(dragged, { y: rowPitch * 2 });
    gsap.set(shifted, { y: -rowPitch });
    if (preview) gsap.set(preview, { opacity: 0.5, y: 6 });

    ScrollTrigger.create({
      trigger: root,
      start: 'top 70%',
      once: true,
      onEnter: () => {
        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.to(dragged, { y: 0, duration: 0.7, boxShadow: '0 12px 24px -8px rgb(17 17 16 / 0.25)' }, 0)
          .to(shifted, { y: 0, duration: 0.6, stagger: 0.08 }, 0.05)
          .set(dragged, { boxShadow: 'none' }, 0.75)
          .to(preview, { opacity: 1, y: 0, duration: 0.5 }, 0.5);
      },
    });
  });
</script>
