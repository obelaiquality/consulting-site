---
/* Escalation: a Customer Complaint can be escalated to a Nonconformance or a Supplier Deviation. */
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<div class:list={['esc-card', cls]} aria-hidden="true">
  <div class="esc-source">
    <span class="pill pill-green">CC-001</span>
    <p class="esc-name">Customer Complaint</p>
  </div>
  <div class="esc-links">
    <span class="esc-line"></span>
    <span class="esc-tag">Escalate</span>
    <span class="esc-line"></span>
  </div>
  <div class="esc-targets">
    <div class="esc-target">
      <span class="pill pill-amber">NC-001</span>
      <p class="esc-name">Nonconformance</p>
    </div>
    <div class="esc-target">
      <span class="pill pill-blue">SD-001</span>
      <p class="esc-name">Supplier Deviation</p>
    </div>
  </div>
</div>

<style>
  .esc-card { border-radius: 16px; background: var(--color-surface); border: 1px solid var(--color-line); box-shadow: var(--shadow-lift); padding: 24px; display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  .esc-name { margin-top: 6px; font-size: 13px; font-weight: 500; color: var(--color-ink); }
  .esc-links { display: flex; align-items: center; gap: 10px; padding: 14px 0; }
  .esc-line { width: 40px; height: 1.5px; background: var(--color-line); }
  .esc-tag { font-size: 11px; color: var(--color-muted); padding: 4px 10px; border: 1px solid var(--color-line); border-radius: 999px; }
  .esc-targets { display: flex; gap: 32px; }
  .esc-target { display: flex; flex-direction: column; align-items: center; }
</style>
