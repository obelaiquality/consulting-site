---
/*
 * "We run it. You use it." — the managed-service pitch, using `managed` from data/site.ts.
 * Left: sticky heading block. Right: cards that stack via position:sticky with increasing
 * top offsets; on desktop each card scales down and dims as the next one arrives (GSAP scrub).
 * Mobile: plain stacked list, no sticky, no scrub.
 */
import { managed } from '../../data/site';
---
<section class="managed-stack section-y" aria-labelledby="managed-heading">
  <div class="container-x">
    <div class="managed-grid">
      <div class="managed-head">
        <h2 id="managed-heading" class="t-h2">We run it. You use it.</h2>
        <p class="t-lead mt-4">Obel MS is a managed service. Your monthly fee covers the software, the hosting and the people who keep it healthy.</p>
      </div>

      <div class="managed-cards">
        {managed.map((item, i) => (
          <div class="managed-card-wrap" style={`--i:${i}`}>
            <div class="managed-card card" data-managed-card>
              <div class="managed-card-body">
                <h3 class="t-h3">{item.title}</h3>
                <p class="t-body mt-2 max-w-[34ch]">{item.body}</p>
              </div>

              <div class="managed-indicator" aria-hidden="true">
                {item.title === 'Hosting' && (
                  <span class="pill pill-green">africa-south1</span>
                )}
                {item.title === 'Backups' && (
                  <div class="mi-ticks">
                    {Array.from({ length: 7 }).map((_, d) => (
                      <span class:list={['mi-tick', { 'is-done': d === 6 }]}></span>
                    ))}
                    <span class="text-[11px] text-muted tnum ml-2">Today 02:00</span>
                  </div>
                )}
                {item.title === 'Updates' && (
                  <span class="pill pill-green">v2.14 deployed</span>
                )}
                {item.title === 'Migration' && (
                  <p class="text-[13px] text-muted">
                    Latest import <span class="tnum text-ink font-medium">1,284 rows</span>
                  </p>
                )}
                {item.title === 'Support' && (
                  <div class="mi-support">
                    <svg class="size-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6"/><path d="M8 4.5V8l2.5 1.5"/></svg>
                    <span class="text-[13px] text-muted">Reply within 1 business day</span>
                  </div>
                )}
                {item.title === 'Monitoring' && (
                  <svg class="mi-spark" viewBox="0 0 96 28" fill="none" aria-hidden="true">
                    <polyline points="0,20 12,17 24,19 36,10 48,13 60,6 72,9 84,4 96,7" stroke="var(--color-green)" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                  </svg>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .managed-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; }
  @media (min-width: 1024px) {
    .managed-grid { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 4rem; align-items: start; }
    .managed-head { position: sticky; top: calc(var(--nav-h) + 40px); }
  }

  .managed-cards { display: flex; flex-direction: column; gap: 1.1rem; }

  .managed-card { background: var(--color-surface); border: 1px solid var(--color-line); border-radius: 18px; padding: 30px 32px; min-height: 260px; display: flex; flex-direction: column; justify-content: space-between; box-shadow: var(--shadow-soft); }
  .managed-card-body h3 { color: var(--color-ink); }
  .managed-indicator { margin-top: 24px; }

  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .managed-card-wrap { position: sticky; top: calc(var(--nav-h) + 40px + var(--i) * 14px); z-index: calc(var(--i) + 1); padding-bottom: 2.5rem; }
    .managed-card { transform-origin: top center; will-change: transform, opacity; }
  }

  /* Backups: seven day-ticks, the last one green for today. */
  .mi-ticks { display: flex; align-items: center; gap: 5px; }
  .mi-tick { width: 9px; height: 9px; border-radius: 2px; background: var(--color-surface-3); }
  .mi-tick.is-done { background: var(--color-green); }

  .mi-support { display: flex; align-items: center; gap: 8px; color: var(--color-muted); }

  .mi-spark { width: 120px; height: 32px; }
</style>

<script>
  import { onReady, gsap, reduced } from '../../scripts/motion';

  onReady(() => {
    if (reduced) return;
    const mm = gsap.matchMedia();
    mm.add('(min-width: 1024px)', () => {
      const cards = gsap.utils.toArray<HTMLElement>('[data-managed-card]');
      cards.forEach((card, i) => {
        const next = cards[i + 1];
        if (!next) return;
        gsap.to(card, {
          scale: 0.94,
          opacity: 0.55,
          ease: 'none',
          scrollTrigger: { trigger: next, start: 'top bottom', end: 'top top', scrub: 0.6 },
        });
      });
    });
  });
</script>
