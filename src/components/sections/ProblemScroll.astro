---
/*
 * "The problem" on paper background. One large Syne statement whose words fill from dim to ink
 * as the section scrolls. Below it, "desk to register": three real-looking fragments (an email
 * thread, a shared-drive folder, an old tracker spreadsheet) each hand one fact to one Obel-MS
 * record as the reader scrolls: the expiry date, the current version, the approval. Dot trails
 * carry each fact (scripts/threeui/desk-flow.ts, adapted from ThreeUI "Gateway Flow").
 * Claims: the spreadsheet is the tracker Obel-MS replaces, not an import (EDC takes PDF and
 * images only). The scene repeats the statement, so it is aria-hidden. Names are synthetic.
 */
---
<section class="problem-scroll section-y" aria-labelledby="problem-heading">
  <div class="container-x">
    <p id="problem-heading" class="problem-text" data-problem-text>
      The contract is in someone's inbox. The policy is on a shared drive. The approval is buried in an email thread. Then someone asks for the current version.
    </p>
    <p class="problem-sub t-body mt-8">
      Obel-MS turns the pile into one record: the current version, when it expires and who approved it.
    </p>

    <div class="desk" data-desk aria-hidden="true">
      <canvas class="desk-dots" data-desk-dots></canvas>

      <div class="pile">
        <!-- Email thread: holds the approval. -->
        <article class="frag frag-mail" data-frag>
          <header class="frag-bar"><span class="frag-app">Inbox</span><span class="frag-count tnum">14 messages</span></header>
          <div class="mail-head">
            <p class="mail-subj">RE: FW: RE: Ledgerline DPA, signed copy?</p>
            <p class="mail-from">Pieter van Wyk <span class="tnum">Tue 09:02</span></p>
          </div>
          <p class="mail-body">Is v3 the final one? I only have v2 on the drive.</p>
          <blockquote class="mail-quote"><span class="fact" data-src="approval">Approved, go ahead with v3. Thandi</span></blockquote>
        </article>

        <!-- Shared drive: holds the current version, among near-duplicates. -->
        <article class="frag frag-drive" data-frag>
          <header class="frag-bar"><span class="frag-app">Shared drive</span><span class="frag-path">Legal › Vendors › Ledgerline</span></header>
          <ul class="drive-list">
            <li><span class="file-ic"></span><span>DPA_v2.pdf</span></li>
            <li><span class="file-ic"></span><span>DPA_v3_FINAL.pdf</span></li>
            <li><span class="file-ic"></span><span class="fact" data-src="version">DPA_v3_FINAL_signed(1).pdf</span></li>
            <li><span class="file-ic"></span><span>DPA_v3_FINAL_old.pdf</span></li>
          </ul>
        </article>

        <!-- Old tracker spreadsheet: holds a doubtful expiry date. -->
        <article class="frag frag-sheet" data-frag>
          <header class="frag-bar"><span class="frag-app">Vendor tracker (old).xlsx</span></header>
          <table class="sheet">
            <thead><tr><th></th><th>A</th><th>B</th><th>C</th></tr></thead>
            <tbody>
              <tr><th>1</th><td>Document</td><td>Expires</td><td>Owner</td></tr>
              <tr><th>2</th><td>Ledgerline DPA</td><td><span class="fact" data-src="expiry">31/10/27?</span></td><td>Pieter</td></tr>
              <tr><th>3</th><td>PI cover</td><td>31/03/2027</td><td>Thandi</td></tr>
              <tr><th>4</th><td>B-220 calibration</td><td class="sheet-err">#REF!</td><td></td></tr>
            </tbody>
          </table>
        </article>
      </div>

      <!-- The one record. Each field starts as a skeleton and fills when its fact arrives. -->
      <div class="rec" data-rec>
        <div class="rec-top">
          <span class="rec-type">External Document Control</span>
          <span class="rec-pill"><span class="pill pill-grey rec-wait">Draft</span><span class="pill pill-green rec-ok">Validated</span></span>
        </div>
        <div class="field field-title" data-dst="version">
          <span class="skel"></span>
          <span class="val">Data processing agreement, version 3</span>
        </div>
        <dl class="rec-meta">
          <div><dt>Supplier</dt><dd>Ledgerline Cloud</dd></div>
          <div>
            <dt>Expiration date</dt>
            <dd class="field" data-dst="expiry"><span class="skel"></span><span class="val tnum">2027-10-31</span></dd>
          </div>
        </dl>
        <p class="rec-alert">Reminder by email and Teams 30 days before it expires.</p>
        <div class="field rec-audit" data-dst="approval">
          <span class="skel"></span>
          <span class="val"><span class="rec-check"><svg viewBox="0 0 16 16" fill="none"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span><b>Thandi Mokoena</b> approved</span><span class="tnum rec-time">2026-10-06 09:14</span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .problem-scroll { background: var(--color-bg); }
  .problem-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    max-width: 24ch;
    color: var(--color-ink);
  }
  /* Reduced motion / no-JS fallback: text is simply ink, no per-word span needed. */
  .problem-text :global(.word) { color: #c9c9c2; }

  /* ---------- Desk to register ---------- */
  .desk { position: relative; display: grid; gap: 2.5rem; margin-top: clamp(3rem, 6vw, 5rem); }
  .desk-dots { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 3; display: none; }
  @media (min-width: 1024px) {
    .desk { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 5rem; align-items: center; min-height: 520px; }
    .desk-dots { display: block; }
  }

  /* The pile: overlapping, slightly turned fragments on desktop; a tidy stack on small screens. */
  .pile { position: relative; display: grid; gap: 14px; }
  @media (min-width: 1024px) { .pile { display: block; height: 520px; } }
  .frag { position: relative; border: 1px solid var(--color-line); border-radius: 12px; background: var(--color-surface); box-shadow: 0 1px 2px rgb(17 17 16 / .04), 0 14px 34px -18px rgb(17 17 16 / .22); font-size: 12.5px; color: var(--color-muted); overflow: hidden; transition: opacity .6s var(--ease-calm); }
  @media (min-width: 1024px) {
    .frag { position: absolute; }
    .frag-mail { left: 0; top: 0; width: 58%; rotate: -1.4deg; z-index: 2; }
    .frag-drive { right: 0; top: 30%; width: 50%; rotate: 1.2deg; z-index: 1; }
    .frag-sheet { left: 6%; bottom: 0; width: 60%; rotate: -.8deg; z-index: 2; }
  }
  .desk:global(.is-done) .frag { opacity: .55; }
  .frag-bar { display: flex; align-items: center; justify-content: space-between; gap: 10px; height: 32px; padding: 0 12px; border-bottom: 1px solid var(--color-surface-3); background: var(--color-surface-2); font-size: 11.5px; }
  .frag-app { font-weight: 600; color: var(--color-ink); }
  .frag-path, .frag-count { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .mail-head { padding: 12px 14px 0; }
  .mail-subj { font-size: 13.5px; font-weight: 600; color: var(--color-ink); }
  .mail-from { margin-top: 2px; display: flex; justify-content: space-between; gap: 10px; }
  .mail-body { padding: 10px 14px 0; color: var(--color-ink); }
  .mail-quote { margin: 10px 14px 14px; padding-left: 10px; border-left: 2px solid var(--color-line); }

  .drive-list { margin: 0; padding: 6px 0; list-style: none; }
  .drive-list li { display: flex; align-items: center; gap: 10px; height: 32px; padding: 0 14px; color: var(--color-ink); }
  .file-ic { flex: none; width: 14px; height: 17px; border: 1px solid var(--color-line-hover); border-radius: 2px 5px 2px 2px; background: var(--color-surface-2); }

  .sheet { width: 100%; border-collapse: collapse; font-size: 12px; table-layout: fixed; }
  .sheet th, .sheet td { height: 28px; padding: 0 8px; border: 1px solid var(--color-surface-3); text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sheet thead th, .sheet tbody th { background: var(--color-surface-2); font-weight: 500; color: var(--color-muted); text-align: center; }
  .sheet thead th:first-child, .sheet tbody th { width: 28px; padding: 0; }
  .sheet tbody td { color: var(--color-ink); }
  .sheet tbody tr:first-child td { font-weight: 600; }
  .sheet-err { color: var(--color-red-text) !important; }

  /* A fact: highlighted when it is picked up. */
  .fact { position: relative; padding: 1px 4px; margin: -1px -4px; border-radius: 4px; transition: background-color .35s var(--ease-calm), box-shadow .35s var(--ease-calm); }
  .fact:global(.is-lit) { background: var(--color-amber-bg); box-shadow: inset 0 0 0 1px var(--color-amber-border); }
  .desk:global(.is-done) .fact:global(.is-lit) { background: var(--color-green-bg); box-shadow: inset 0 0 0 1px var(--color-green-border); }

  /* The record. */
  .rec { position: relative; z-index: 2; padding: 22px 24px 20px; border: 1px solid var(--color-line); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-soft); transition: border-color .6s var(--ease-calm), box-shadow .6s var(--ease-calm); }
  .rec:global(.is-done) { border-color: var(--color-green-border); box-shadow: 0 1px 2px rgb(17 17 16 / .04), 0 22px 60px -22px rgb(22 101 52 / .3); }
  .rec-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .rec-type { font-size: 12.5px; color: var(--color-muted); }
  .rec-pill { display: grid; justify-items: end; }
  .rec-pill > * { grid-area: 1 / 1; transition: opacity .35s var(--ease-calm), transform .45s var(--ease-spring); }
  .rec-ok { opacity: 0; transform: scale(.94); }
  .rec:global(.is-done) .rec-ok { opacity: 1; transform: none; }
  .rec:global(.is-done) .rec-wait { opacity: 0; }

  /* Fields: a skeleton bar, then the value. Opacity and transform only. */
  .field { position: relative; display: grid; }
  .field > * { grid-area: 1 / 1; }
  .skel { align-self: center; height: .7em; width: 70%; border-radius: 4px; background: var(--color-surface-3); transition: opacity .3s var(--ease-calm); }
  .val { opacity: 0; transform: translateX(-6px); transition: opacity .4s var(--ease-out), transform .5s var(--ease-out); }
  .field:global(.is-filled) .skel { opacity: 0; }
  .field:global(.is-filled) .val { opacity: 1; transform: none; }
  .field-title { margin-top: 12px; font-family: var(--font-display); font-size: clamp(1.2rem, 1.7vw, 1.45rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; color: var(--color-ink); min-height: 1.75em; }
  .field-title .skel { height: .8em; width: 82%; }
  .rec-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 16px 0 0; padding-top: 14px; border-top: 1px solid var(--color-surface-3); }
  .rec-meta dt { font-size: 11.5px; color: var(--color-muted); }
  .rec-meta dd { margin: 3px 0 0; font-size: 14px; color: var(--color-ink); min-height: 1.3em; }
  .rec-meta .skel { width: 60%; }
  .rec-alert { margin-top: 12px; font-size: 12.5px; color: var(--color-muted); }
  .rec-audit { margin-top: 14px; padding: 11px 12px; border-radius: var(--radius-md); background: var(--color-surface-2); font-size: 13px; color: var(--color-muted); min-height: 46px; }
  .rec-audit .skel { width: 55%; }
  .rec-audit .val { display: flex; align-items: center; gap: 10px; }
  .rec-audit b { color: var(--color-ink); font-weight: 600; }
  .rec-time { margin-left: auto; white-space: nowrap; }
  .rec-check { display: grid; place-items: center; flex: none; width: 22px; height: 22px; border-radius: 99px; background: var(--color-green); color: #fff; }
  .rec-check svg { width: 12px; height: 12px; }

  @media (max-width: 1023px) {
    .frag-mail { rotate: -.6deg; } .frag-drive { rotate: .5deg; } .frag-sheet { rotate: -.3deg; }
    .rec-time { display: none; }
  }
</style>

<script>
  import { onReady, gsap, SplitText, reduced } from '../../scripts/motion';
  import { mountDeskFlow } from '../../scripts/threeui/desk-flow';

  onReady(() => {
    const desk = document.querySelector<HTMLElement>('[data-desk]');
    if (desk) mountDeskFlow(desk);

    const el = document.querySelector<HTMLElement>('[data-problem-text]');
    if (!el) return;

    if (reduced) {
      // Final state only: no split, no scrub. Content stays complete and readable.
      return;
    }

    const split = new SplitText(el, { type: 'words', wordsClass: 'word' });
    gsap.set(split.words, { color: '#c9c9c2' });

    gsap.to(split.words, {
      color: '#111110',
      stagger: 0.5,
      ease: 'none',
      scrollTrigger: {
        trigger: el,
        start: 'top 75%',
        end: 'bottom 45%',
        scrub: 1,
      },
    });
  });
</script>
