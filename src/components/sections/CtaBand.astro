---
/*
 * Closing CTA band. Ink surface, centred Syne line, and behind it an engraved guilloche
 * rosette (the security-print pattern of deeds and certificates) that turns slowly with
 * scroll. Adapted from the ThreeUI "Engraved Certificate" (scripts/threeui/engraved-rosette.ts).
 */
---

<section class="cta-band relative overflow-hidden bg-night text-center" aria-labelledby="cta-heading">
  <div class="cta-mark" data-parallax="0.08" aria-hidden="true">
    <div class="cta-rosette" data-rosette>
      <canvas data-rosette-base></canvas>
      <canvas data-rosette-drift></canvas>
    </div>
  </div>

  <div class="container-x relative">
    <h2 id="cta-heading" class="t-hero text-night-fg mx-auto max-w-[16ch]" data-split>
      Get your documents in order this quarter.
    </h2>
    <p class="cta-lead mx-auto mt-6" data-reveal>
      Book a 20-minute demo and see External Document Control and Workflow Manager on your own documents.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4" data-reveal>
      <a href="/contact#demo" class="btn btn-light" data-magnetic>Book a demo</a>
      <a href="/pricing" class="btn btn-night-ghost">See pricing</a>
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: clamp(4.5rem, 14vw, 160px); }

  /* Centred with inset + margin, not a transform: data-parallax animates the transform. */
  .cta-mark {
    --s: clamp(520px, 72vw, 1000px);
    position: absolute;
    inset: 0;
    width: var(--s);
    height: var(--s);
    margin: auto;
    pointer-events: none;
    z-index: 0;
    will-change: transform;
  }

  .cta-rosette { position: absolute; inset: 0; }
  .cta-rosette canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* Fade the engraving toward its centre so the headline always sits on clean ink. */
  .cta-rosette { mask-image: radial-gradient(circle, transparent 18%, #000 52%); }

  .cta-lead {
    max-width: 42ch;
    font-size: clamp(1.05rem, 1.35vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-night-muted);
  }
</style>

<script>
  import { onReady } from '../../scripts/motion';
  import { mountEngravedRosette } from '../../scripts/threeui/engraved-rosette';
  onReady(() => {
    const el = document.querySelector<HTMLElement>('[data-rosette]');
    if (el) mountEngravedRosette(el, [240, 240, 236], 0.32);
  });
</script>
