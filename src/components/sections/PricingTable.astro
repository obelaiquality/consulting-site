---
/*
 * Pricing table. Every price carries all site currencies (ui/Money); CSS shows the visitor's currency,
 * and the currency picker changes it site-wide. Billing (Annual | Monthly, +15%) switches
 * [data-billing-scope] on this table. Every number comes from src/data/site.ts.
 * A plan with status "waitlist" would show "From" pricing, a badge and a waitlist CTA (none today).
 */
import { plans, pricingTerms, currencies, currencyCodes, fmtMoney } from '../../data/site';
import Money from '../ui/Money.astro';
import CurrencyPicker from '../ui/CurrencyPicker.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class="pricing-table" data-pricing-table data-billing-scope="annual">
  {!compact && (
    <div class="controls flex flex-wrap items-center gap-x-8 gap-y-4 mb-10">
      <div class="flex items-center gap-3">
        <span class="text-[13px] text-muted">Billing</span>
        <div class="switch-group" role="group" aria-label="Billing" data-switch="billing">
          <span class="switch-thumb" data-thumb aria-hidden="true"></span>
          <button type="button" class="switch-btn" data-billing="annual" aria-pressed="true">Annual</button>
          <button type="button" class="switch-btn" data-billing="monthly" aria-pressed="false">Monthly</button>
        </div>
        <span class="switch-note">Monthly is 15% more</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-[13px] text-muted">Currency</span>
        <CurrencyPicker />
      </div>
      <p class="text-[13px] text-muted">{currencyCodes.map((c) => <span data-cur={c}>{currencies[c].taxNote} </span>)}{pricingTerms.contract}</p>
    </div>
  )}

  <div class="grid gap-5 md:grid-cols-3 md:items-start" data-reveal-group>
    {plans.map((p) => (
      <div
        class:list={['plan-card', p.featured ? 'plan-featured' : 'card', { 'plan-waitlist': p.status === 'waitlist' }]}
        data-plan={p.id}
        data-reveal
      >
        <div class:list={['flex h-full flex-col p-7', p.featured ? 'md:py-9' : 'md:py-8']}>
          <div class="flex items-center justify-between gap-3">
            <h3 class="t-h3">{p.name}</h3>
            {p.status === 'waitlist' && <span class="pill pill-grey">Coming 2027</span>}
            
          </div>
          <p class:list={['mt-2 text-[14px] leading-relaxed', p.featured ? 'text-night-muted' : 'text-muted']}>
            {p.blurb}
          </p>

          <div class="mt-6 flex items-baseline gap-1.5">
            {p.status === 'waitlist' && <span class="text-[15px] text-muted">From</span>}
            <span class="price-roll" data-price-roll>
              <span class="price-num t-num tnum" data-price-num><Money amount={p.price} monthly /></span>
            </span>
            <span class:list={['text-[15px]', p.featured ? 'text-night-muted' : 'text-muted']}>/month</span>
          </div>
          <p class:list={['mt-1.5 text-[12.5px]', p.featured ? 'text-night-muted' : 'text-muted']} data-price-note>
            {currencyCodes.map((c) => <span data-cur={c}>{p.setup[c] > 0 ? `Plus ${fmtMoney(p.setup[c], c)} once for ${p.setup.label}.` : `${p.setup.label}.`}</span>)}
          </p>
          <p class:list={['mt-4 text-[13px]', p.featured ? 'text-night-muted' : 'text-muted']}>{p.users}</p>

          <a
            href={`/contact?plan=${p.id}#demo`}
            class:list={['btn mt-6 w-full', p.featured ? 'btn-light' : 'btn-ghost']}
          >
            {p.cta}
          </a>
          {!compact && (
            <a href={`/checkout?plan=${p.id}`} class:list={['buy-link mt-3 text-[13px]', p.featured ? 'text-night-muted' : 'text-muted']}>
              Start your workspace <span class="pill pill-amber ml-1">Online payment soon</span>
            </a>
          )}

          <ul class="mt-7 space-y-3">
            {(compact ? p.features.slice(0, 5) : p.features).map((f) => (
              <li class="flex items-start gap-2.5 text-[14px] leading-snug">
                <svg
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                  class:list={['check-icon mt-0.5 shrink-0', p.featured ? 'text-green-bright' : 'text-ink']}
                >
                  <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class={p.featured ? 'text-night-muted' : 'text-muted'}>{f}</span>
              </li>
            ))}
          </ul>

          {compact && (
            <a href="/pricing" class="link-u mt-6 text-[14px] font-medium text-ink">
              Compare plans in detail
            </a>
          )}
        </div>
      </div>
    ))}
  </div>

  <div class="mt-10 max-w-[64ch] space-y-2">
    <p class="text-[14px] text-muted">
      Every plan is hosted on Google Cloud in the region you choose, with daily backups, updates and support included. {currencyCodes.map((c) => <span data-cur={c}>{currencies[c].taxNote} </span>)}{pricingTerms.contract} {pricingTerms.aiNote}
    </p>
    {!compact && (
      <p class="text-[13px] text-muted">
        Enterprise QMS platforms often cost R200,000 a year or more, before setup.
      </p>
    )}
  </div>
</div>

<style>
  .check-icon { width: 14px; height: 14px; }

  .buy-link { display: inline-flex; align-items: center; justify-content: center; gap: 4px; min-height: 32px; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: currentColor; }
  .switch-note { font-size: 12.5px; color: var(--color-green); font-weight: 500; }

  .plan-card { border-radius: var(--radius-lg); }
  .plan-waitlist { background: transparent; border-style: dashed; }
  .plan-featured {
    background: var(--color-night);
    color: var(--color-night-fg);
    border: 1px solid var(--color-night-line);
    box-shadow: var(--shadow-window);
  }

  .price-roll { position: relative; display: inline-block; overflow: hidden; line-height: 1; }
  .price-num { display: block; font-size: clamp(1.9rem, 2.6vw, 2.35rem); }

  @media (prefers-reduced-motion: reduce) {
  }
</style>

<script>
  import { onReady, gsap, reduced } from '../../scripts/motion';

  onReady(() => {
    const root = document.querySelector<HTMLElement>('[data-pricing-table]');
    if (!root) return;
    const nums = () => Array.from(root.querySelectorAll<HTMLElement>('[data-price-num]'));
    // A short vertical roll whenever the shown price changes.
    const roll = (apply: () => void) => {
      if (reduced) return apply();
      gsap.to(nums(), { yPercent: -60, opacity: 0, duration: 0.16, ease: 'power2.in', onComplete: () => {
        apply();
        gsap.fromTo(nums(), { yPercent: 60, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.22, ease: 'power2.out' });
      } });
    };

    const group = root.querySelector<HTMLElement>('[data-switch="billing"]');
    if (group) {
      const thumb = group.querySelector<HTMLElement>('[data-thumb]');
      const buttons = Array.from(group.querySelectorAll<HTMLButtonElement>('.switch-btn'));
      buttons.forEach((btn, i) => btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        if (thumb) thumb.style.transform = `translateX(${i * 100}%)`;
        roll(() => { root.dataset.billingScope = btn.dataset.billing === 'monthly' ? 'monthly' : 'annual'; });
      }));
    }
    document.addEventListener('currencychange', () => {
      if (reduced) return;
      gsap.fromTo(nums(), { yPercent: 60, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.24, ease: 'power2.out' });
    });
  });
</script>
