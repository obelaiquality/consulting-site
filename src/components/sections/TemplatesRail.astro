---
/*
 * The five standard templates, one card each, from demo.ts wfmTemplates.
 * This is the quiet part after the pinned Workflow Manager scene, so it does not pin or scrub.
 * Wide screens: five cards in one row. Narrower screens: a native scroll-snap row with faded edges.
 */
import { wfmTemplates } from '../../data/demo';
---

<section class="tr-scene bg-night" data-templates-rail aria-labelledby="tr-heading">
  <div class="container-x"><div class="tr-head">
    <h2 id="tr-heading" class="t-h2 text-night-fg">Five templates, ready on day one.</h2>
    <p class="tr-lead">
      Each template covers a process that auditors, clients and regulators ask about. Change any stage, deadline
      or approver in the template designer, or build your own templates.
    </p></div>
  </div>

  <div class="tr-scroller" data-tr-scroller tabindex="0" aria-label="Workflow Manager templates">
    <div class="container-x">
      <div class="tr-track" data-tr-track>
        {
          wfmTemplates.map((t) => {
            const approvalSet = new Set(t.approvals);
            const lastIdx = t.stages.length - 1;
            return (
              <article class="tr-panel" data-reveal>
                <p class="tr-panel-code tnum">Standard template</p>
                <h3 class="tr-panel-name">{t.name}</h3>
                <p class="tr-panel-count">{t.stages.length} stages</p>
                <ol class="tr-panel-stages">
                  {t.stages.map((stage, i) => (
                    <li class="tr-panel-stage">
                      <span class="tr-panel-num tnum">{i + 1}</span>
                      <span class="tr-panel-stage-name">{stage}</span>
                      {approvalSet.has(i) && <span class="tr-tag">Approval</span>}
                      {t.verification && i === lastIdx && <span class="tr-tag tr-tag-verify">Effectiveness check</span>}
                    </li>
                  ))}
                </ol>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .tr-scene { position: relative; overflow: hidden; padding-block: clamp(2rem, 4vw, 3rem) clamp(6rem, 10vw, 9rem); }
  .tr-head { max-width: 40rem; }
  .tr-lead { margin-top: 1.25rem; font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.55; color: var(--color-night-muted); }

  .tr-scroller { margin-top: 3rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter, 20px); -webkit-overflow-scrolling: touch; scrollbar-width: none;
    mask-image: linear-gradient(90deg, transparent 0, #000 16px, #000 calc(100% - 48px), transparent 100%); }
  .tr-scroller::-webkit-scrollbar { display: none; }
  .tr-scroller:focus-visible { outline: 2px solid var(--color-green-bright); outline-offset: 4px; }
  .tr-track { display: flex; gap: 14px; padding-bottom: 4px; }

  .tr-panel { flex: none; width: min(82vw, 320px); scroll-snap-align: start; display: flex; flex-direction: column;
    background: var(--color-night-2); border: 1px solid var(--color-night-line); border-radius: 16px; padding: 22px 22px 24px;
    transition: border-color .5s var(--ease-calm), background-color .5s var(--ease-calm); }
  .tr-panel:hover { border-color: rgb(255 255 255 / 0.18); }
  .tr-panel-code { font-size: 12px; color: var(--color-night-muted); }
  .tr-panel-name { margin-top: 6px; font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: -0.02em; line-height: 1.1; color: var(--color-night-fg); }
  .tr-panel-count { margin-top: 4px; font-size: 13px; color: var(--color-night-muted); }

  .tr-panel-stages { margin-top: 18px; padding-top: 18px; border-top: 1px solid var(--color-night-line); display: flex; flex-direction: column; gap: 12px; }
  .tr-panel-stage { display: grid; grid-template-columns: 18px 1fr; column-gap: 8px; row-gap: 5px; align-items: baseline; }
  .tr-panel-num { font-size: 12px; color: var(--color-night-muted); }
  .tr-panel-stage-name { font-size: 14px; line-height: 1.35; color: var(--color-night-fg); }
  .tr-tag { grid-column: 2; justify-self: start; display: inline-flex; align-items: center; height: 19px; padding: 0 8px; border-radius: 999px; border: 1px solid var(--color-night-line); font-size: 10.5px; font-weight: 600; color: var(--color-night-muted); }
  .tr-tag-verify { border-color: var(--color-green-border); color: var(--color-green-bright); }

  @media (min-width: 1280px) {
    .tr-scroller { overflow: visible; mask-image: none; scroll-snap-type: none; }
    .tr-track { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
    .tr-panel { width: auto; padding: 20px 18px 22px; }
    .tr-panel-name { font-size: 19px; white-space: nowrap; }
  }
</style>
