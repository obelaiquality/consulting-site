---
import RelatedGuides from '../components/RelatedGuides.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PricingTable from '../components/sections/PricingTable.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { plans, site, addons, services, pricingTerms, discounts } from '../data/site';

type Cell = true | false | string;
interface CompareRow {
  label: string;
  values: [Cell, Cell, Cell];
}
interface CompareGroup {
  name: string;
  rows: CompareRow[];
}

/* Every row below mirrors a claim in docs/BUILD-SPEC.md section 6 and a feature already
 * listed for that tier in src/data/site.ts — nothing here is invented. */
const compareGroups: CompareGroup[] = [
  {
    name: 'Documents',
    rows: [
      { label: 'External Document Control', values: [true, true, true] },
      { label: 'Expiry alerts by email and Teams', values: [true, true, true] },
      { label: 'Auto-filed Supplier, Manufacturer and Product folders', values: [true, true, true] },
      { label: 'Audit trail and document versioning', values: [true, true, true] },
      { label: 'AI metadata extraction (digital PDFs)', values: ['Fair use', 'Fair use', 'Fair use'] },
      { label: 'Document storage', values: ['10 GB', '25 GB', '100 GB'] },
      { label: 'Scanned-document reading (OCR)', values: ['In testing', 'In testing', 'In testing'] },
    ],
  },
  {
    name: 'Workflows',
    rows: [
      { label: 'Workflow Manager', values: [false, false, true] },
      { label: 'Nonconformance, CAPA, change, complaint and deviation templates', values: [false, false, true] },
      { label: 'Approvals routed by job title', values: [false, false, true] },
      { label: 'Effectiveness verification and PDF record reports', values: [false, false, true] },
      { label: 'AI stage and executive summaries', values: [false, false, true] },
      { label: 'AI assistant with a usage cap', values: [false, false, 'Coming soon'] },
    ],
  },
  {
    name: 'Platform',
    rows: [
      { label: 'Named users', values: ['3', '10', '30'] },
      { label: 'Read-only viewers', values: ['Unlimited', 'Unlimited', 'Unlimited'] },
      { label: 'Hosted on Google Cloud in Johannesburg', values: [true, true, true] },
      { label: 'Daily backups, encrypted at rest and in transit', values: [true, true, true] },
    ],
  },
  {
    name: 'Service',
    rows: [
      { label: 'Support', values: ['Email, 5 business days', 'Email, 2 business days', 'Next business day'] },
      { label: 'Quarterly 1-hour review call', values: [false, false, true] },
      { label: 'Once-off onboarding', values: ['None', 'R6,500', 'R15,000'] },
    ],
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: plans
    .filter((p) => p.status === 'live')
    .map((p) => ({
      '@type': 'Offer',
      name: p.name,
      price: p.price.ZAR,
      priceCurrency: 'ZAR',
      priceSpecification: { '@type': 'UnitPriceSpecification', price: p.price.ZAR, priceCurrency: 'ZAR', unitText: 'MONTH', valueAddedTaxIncluded: false },
      url: `${site.url}/pricing`,
    })),
};
---

<BaseLayout
  title="ISO 9001 QMS software pricing | Obel MS"
  description="Hosted ISO 9001 document control from R1,490 a month excl. VAT. Workflow Manager from R7,950. Hosted in Johannesburg, support included."
  breadcrumbs={[{ name: 'Pricing', href: '/pricing' }]}
  jsonLd={jsonLd}
>
  <section class="pricing-hero section-y !pb-16">
    <div class="container-x">
      <h1 class="pricing-h1 max-w-[18ch]" data-split data-split-load>
        Simple pricing. Hosting and support included.
      </h1>
      <p class="t-lead mt-6" data-reveal>
        Three plans for teams of different sizes. Hosting, backups, updates and support are in every plan. All ZAR prices exclude 15% VAT.
      </p>
    </div>
  </section>

  <section class="section-y !pt-0">
    <div class="container-x">
      <PricingTable />
    </div>
  </section>

  <section class="section-y" aria-labelledby="compare-heading">
    <div class="container-x">
      <h2 id="compare-heading" class="t-h2 max-w-[20ch]" data-reveal>Compare plans in detail</h2>
      <div class="compare-scroll mt-10">
        <table class="compare-table">
          <caption class="sr-only">Feature comparison across Lite, Essentials and Professional</caption>
          <thead>
            <tr>
              <th scope="col" class="compare-feature-col">Feature</th>
              {plans.map((p) => (
                <th scope="col" class:list={['compare-plan-col', { 'is-featured': p.featured }]}>{p.name}</th>
              ))}
            </tr>
          </thead>
          {compareGroups.map((group) => (
            <tbody>
              <tr class="compare-group-row">
                <th colspan={plans.length + 1} class="compare-group-label">{group.name}</th>
              </tr>
              {group.rows.map((row) => (
                <tr>
                  <th scope="row" class="compare-feature-col">{row.label}</th>
                  {row.values.map((v, i) => (
                    <td class:list={['compare-cell', { 'is-featured': plans[i].featured }]}>
                      {v === true ? (
                        <>
                          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true" class="check-icon text-ink">
                            <path d="M3.5 8.5 6.5 11.5 12.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <span class="sr-only">Included</span>
                        </>
                      ) : v === false ? (
                        <>
                          <span aria-hidden="true" class="text-dim">&ndash;</span>
                          <span class="sr-only">Not included</span>
                        </>
                      ) : (
                        <span class="tnum text-[13.5px]">{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
    </div>
  </section>

  <section class="section-y !pt-0" aria-labelledby="extras-heading">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <h2 id="extras-heading" class="t-h3">Add-ons</h2>
        <p class="t-body mt-2">Grow a plan without changing tier.</p>
        <dl class="extras mt-6">
          {addons.map((a) => (
            <div class="extras-row"><dt>{a.name}</dt><dd class="tnum">R{a.price.ZAR.toLocaleString('en-US')} {a.unit}</dd></div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="t-h3">Quality consulting</h2>
        <p class="t-body mt-2">Our consultants help with implementation, internal audits and audit days.</p>
        <dl class="extras mt-6">
          {services.map((a) => (
            <div class="extras-row"><dt>{a.name}</dt><dd class="tnum">R{a.price.ZAR.toLocaleString('en-US')} {a.unit}</dd></div>
          ))}
        </dl>
      </div>
      <div class="lg:col-span-2">
        <h2 class="t-h3">Discounts</h2>
        <dl class="extras mt-6 max-w-2xl">
          {discounts.map((d) => (
            <div class="extras-row"><dt>{d.name}</dt><dd>{d.value}</dd></div>
          ))}
        </dl>
        <p class="text-[13px] text-muted mt-6">{pricingTerms.vatNote} {pricingTerms.contract} USD prices are for clients outside South Africa. {pricingTerms.availability}</p>
        <p class="text-[13px] text-muted mt-2">{pricingTerms.aiNote} {pricingTerms.fairUse}</p>
      </div>
    </div>
  </section>

  <Faq tags={['pricing']} heading="Pricing questions" withSchema />

  <RelatedGuides slugs={['qms-software-cost', 'spreadsheets-vs-qms-software', 'iso-9001-software-south-africa']} />
  <CtaBand />
</BaseLayout>

<style>
  .pricing-h1 {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-size: clamp(2.4rem, 5.4vw, 4.2rem);
  }

  .check-icon { width: 14px; height: 14px; }

  .compare-scroll { overflow-x: auto; }
  .compare-table {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 14px;
  }
  .compare-table thead th {
    position: sticky;
    top: var(--nav-h);
    z-index: 2;
    background: var(--color-bg);
    text-align: left;
    padding: 12px 16px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    border-bottom: 1px solid var(--color-line);
  }
  .compare-table thead th.is-featured { background: var(--color-surface-2); }
  .compare-plan-col { text-align: center !important; }

  .compare-group-row th {
    text-align: left;
    padding: 20px 16px 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-muted);
    background: var(--color-bg);
  }

  .compare-table tbody tr:not(.compare-group-row) th,
  .compare-table tbody tr:not(.compare-group-row) td {
    padding: 12px 16px;
    border-top: 1px solid var(--color-line-soft);
  }
  .compare-feature-col { text-align: left; font-weight: 500; color: var(--color-ink); max-width: 34ch; }
  .compare-table tbody th.compare-feature-col { font-weight: 400; color: var(--color-muted); }
  .compare-cell { text-align: center; color: var(--color-muted); }
  .compare-cell.is-featured { background: var(--color-surface-2); }
  .extras { border-top: 1px solid var(--color-line); }
  .extras-row { display: flex; justify-content: space-between; gap: 1rem; padding: 14px 0; border-bottom: 1px solid var(--color-line); font-size: 15px; }
  .extras-row dt { color: var(--color-ink); }
  .extras-row dd { color: var(--color-muted); }
</style>
