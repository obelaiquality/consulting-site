---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const sections = [
  {
    title: '1. What this notice covers',
    body: `This notice covers ${site.url.replace('https://', '')}, the marketing website for Obel-MS. It doesn’t cover Obel-MS itself, the hosted product your organisation uses once you’re a customer. Use of the hosted product is governed by your service agreement and, where applicable, a customer data processing agreement. See section 6.`,
  },
  {
    title: '2. This site uses no analytics, tracking or cookies',
    body: 'This site does not use analytics, advertising or tracking scripts, and it does not set cookies. It keeps one setting in your browser’s local storage: the currency you choose for prices (obel-currency). That setting stays on your device, is never sent to us, and you can clear it with your browser data. We don’t know who’s visiting or what they clicked before they reach us.',
  },
  {
    title: '3. The contact form',
    body: site.web3formsKey
      ? `When you send the "Book a demo", workspace request or waitlist form, the details you enter are delivered to ${site.email} through Web3Forms, a form-delivery service based in the United States, which acts as our processor and passes them on by email. We use them only to reply to your request and keep them no longer than needed for that. If sending fails, the page offers to open the request in your own email app instead.`
      : `The "Book a demo" and waitlist forms do not store anything. When you press send, the page prepares an email to ${site.email} and offers to open it in your email app, Gmail or Outlook, or to copy it. We only receive what you choose to send us, the way any email works.`,
  },
  {
    title: '4. What we do with an email you send us',
    body: `Anything you send us, a demo request, a question, a support message, is used to reply to you and, if you become a customer, to set up your account. We don’t sell or share it, and we keep it only as long as we reasonably need to for that purpose.`,
  },
  {
    title: '5. Your rights under POPIA',
    body: 'Under the Protection of Personal Information Act, you can ask what personal information we hold about you, ask us to correct or delete it, object to how it’s used, and lodge a complaint with the Information Regulator. To exercise any of these, contact our Information Officer (section 7).',
  },
  {
    title: '6. The hosted product is different',
    body: 'If your organisation uses Obel-MS, a separate customer data processing agreement covers the documents, records and personal information your team puts into it. This notice does not cover that data. See our Security page for how we host and protect it, or ask us for a copy of the agreement.',
  },
  {
    title: '7. Contact / Information Officer',
    body: `Our Information Officer for POPIA purposes is reachable at ${site.email}. Write to us there with any request or question about this notice.`,
  },
];
---

<BaseLayout title="Privacy notice" description="How the Obel-MS marketing site handles personal information, and your rights under POPIA.">
  <section class="section-y pt-[calc(var(--nav-h)+3rem)]">
    <div class="container-x">
      <div class="max-w-[38rem]">
        <p class="label-dot mb-6">Legal</p>
        <h1 class="t-h2">Privacy notice</h1>
        <p class="mt-4 text-[14px] text-muted tnum">Last updated 26 September 2026</p>
      </div>

      <div class="mt-14 max-w-[38rem] flex flex-col gap-10">
        {sections.map((s) => (
          <div>
            <h2 class="t-h3 !text-[1.15rem]">{s.title}</h2>
            <p class="mt-3 text-[15px] leading-relaxed text-muted">{s.body}</p>
          </div>
        ))}
      </div>

      <div class="mt-20 flex flex-wrap items-center gap-x-6 gap-y-4 border-t border-line pt-10">
        <a href="/security" class="link-u text-[15px] text-ink">Security and hosting</a>
        <a href={`mailto:${site.email}`} class="link-u text-[15px] text-ink">{site.email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
