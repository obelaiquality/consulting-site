---
/* Privacy notice. DRAFT pending legal review (see PR). Retention and sub-processor facts come from the cloud setup (29 Sep 2026). */
import LegalPage, { type LegalSection } from '../../components/LegalPage.astro';
import { site, legal, tbc } from '../../data/site';

const entity = tbc(legal.entity, 'Registered company name');
const sections: LegalSection[] = [
  {
    title: 'What this notice covers',
    body: [
      `This notice explains how ${entity} ("Obel", "we") handles personal information on ${site.url.replace('https://', '')} and, in summary, in Obel-MS, the hosted product.`,
      'On this website, and for our own customer and billing records, we decide how personal information is used (we are the responsible party under POPIA and the controller under GDPR and UK GDPR). Inside a customer’s Obel-MS workspace, the customer decides, and we act for the customer as operator or processor (section 7).',
    ],
  },
  {
    title: 'This site uses no analytics, tracking or cookies',
    body: 'This site does not use analytics, advertising or tracking scripts, and it does not set cookies. It keeps one setting in your browser’s local storage: the currency you choose for prices (obel-currency). That setting stays on your device, is never sent to us, and you can clear it with your browser data.',
  },
  {
    title: 'The forms on this site',
    body: site.web3formsKey
      ? `When you send the "Book a demo", workspace request or waitlist form, the details you enter go to ${site.email} through Web3Forms, a form-delivery service in the United States that acts as our processor. We use them only to reply to your request and, if you become a customer, to set up your workspace. If sending fails, the page offers to open the request in your own email app instead.`
      : `The forms on this site do not store anything. When you press send, the page prepares an email to ${site.email}, and we receive only what you choose to send.`,
  },
  {
    title: 'Who processes information for us',
    body: 'We use these sub-processors. Each one processes personal information only for the purpose shown, under its own data protection terms:',
    items: [
      'Google Cloud: hosting of Obel-MS, in the region the customer chooses.',
      'Paddle: payments, invoices and tax, as Merchant of Record for our orders (United Kingdom and United States).',
      'Amazon Web Services (Simple Email Service): transactional email from Obel-MS, such as invitations and expiry alerts.',
      'Google Workspace: our own email and documents.',
      'Web3Forms: delivery of the forms on this website (United States).',
      'OpenAI: AI metadata extraction and summaries, only for workspaces whose organisation chooses it (United States by default).',
    ],
    after: 'Where information goes to another country, we rely on the safeguards that the law requires, such as standard contractual clauses.',
  },
  {
    title: 'How long we keep information',
    items: [
      `Requests sent through our forms: ${legal.leadRetentionMonths} months after our last contact with you, then deleted.`,
      'Order and billing records: 5 years, as South African tax law requires. Paddle keeps its own records as Merchant of Record.',
      `Customer workspace data: for as long as the subscription runs. After it ends, the customer has ${legal.exportDays} days to export it, and then we delete it from the live system.`,
      `Backups: deleted data leaves our backups within ${legal.backupDays} days. Database backups keep 7 daily copies and 7 days of point-in-time recovery. Document storage keeps old versions and deleted files for up to 90 days.`,
      'Logs: application logs 90 days; security audit logs 400 days.',
    ],
  },
  {
    title: 'What we do with an email you send us',
    body: 'We use what you send us, such as a demo request, a question or a support message, to reply to you and, if you become a customer, to set up and support your workspace. We do not sell or share it for marketing.',
  },
  {
    title: 'Data inside Obel-MS',
    body: [
      'The documents, records and personal information that a customer’s team puts into Obel-MS belong to the customer. We process them only to provide the service, under the customer’s instructions and our Terms of Service. A data processing agreement is available on request.',
      'The data stays in the Google Cloud region the customer chooses. External AI processing is off unless the customer chooses it for the workspace. If you are a user in a customer’s workspace, contact that organisation first about your information; we help them answer your request.',
    ],
  },
  {
    title: 'Your rights',
    body: 'Under POPIA (South Africa), GDPR (European Union) and UK GDPR, you can ask what personal information we hold about you, ask us to correct or delete it, object to how we use it, and, where the law gives the right, ask for a copy in a portable format. You can also complain to a regulator:',
    items: [
      'South Africa: the Information Regulator.',
      'European Union: the data protection authority in your country.',
      'United Kingdom: the Information Commissioner’s Office.',
    ],
  },
  {
    title: 'Contact and Information Officer',
    body: `Our Information Officer under POPIA is ${tbc(legal.informationOfficer, 'Information Officer')}. Write to ${site.email} with any request or question about this notice. We reply within 30 days.`,
  },
];
---
<LegalPage
  title="Privacy notice"
  description="How Obel handles personal information on obel-ai.com and in Obel-MS: forms, sub-processors, retention, hosting region, AI processing and your rights under POPIA, GDPR and UK GDPR."
  sections={sections}
/>
