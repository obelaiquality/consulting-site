---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import ProblemScroll from '../components/sections/ProblemScroll.astro';
import EdcScene from '../components/sections/EdcScene.astro';
import WorkflowShowcase from '../components/sections/WorkflowShowcase.astro';
import TemplatesRail from '../components/sections/TemplatesRail.astro';
import ManagedStack from '../components/sections/ManagedStack.astro';
import Industries from '../components/sections/Industries.astro';
import IdcTeaser from '../components/sections/IdcTeaser.astro';
import PricingTable from '../components/sections/PricingTable.astro';
import Faq from '../components/sections/Faq.astro';
import CtaBand from '../components/sections/CtaBand.astro';
import { plans, site } from '../data/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: site.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: site.description,
  offers: (() => { const live = plans.filter((p) => p.status === 'live'); return { '@type': 'AggregateOffer', priceCurrency: 'ZAR', lowPrice: Math.min(...live.map((p) => p.price.ZAR)), highPrice: Math.max(...live.map((p) => p.price.ZAR)), offerCount: live.length }; })(),
};
---
<BaseLayout jsonLd={jsonLd}>
  <Hero />
  <ProblemScroll />
  <EdcScene />
  <WorkflowShowcase />
  <TemplatesRail />
  <div class="paper-return">
    <ManagedStack />
  </div>
  <Industries />
  <IdcTeaser />
  <section class="section-y" aria-labelledby="home-pricing">
    <div class="container-x">
      <h2 id="home-pricing" class="t-h2 max-w-[18ch]">Priced for small teams with a lot of paperwork.</h2>
      <p class="t-lead mt-5">Hosting, backups, updates and support are in every plan.</p>
    </div>
    <div class="container-x mt-12"><PricingTable compact /></div>
  </section>
  <Faq tags={['general', 'security']} heading="Questions teams ask us" withSchema />
  <CtaBand />
</BaseLayout>

<style>
  /* Paper slides back over the dark scenes with rounded shoulders. */
  .paper-return { position: relative; z-index: 2; margin-top: -32px; background: var(--color-bg); border-radius: 32px 32px 0 0; }
</style>
