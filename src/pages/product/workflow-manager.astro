---
import RelatedGuides from '../../components/RelatedGuides.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeatureRow from '../../components/product/FeatureRow.astro';
import ProductCta from '../../components/product/ProductCta.astro';
import MockRecordsList from '../../components/product/MockRecordsList.astro';
import MockTemplatesList from '../../components/product/MockTemplatesList.astro';
import MockTemplateDesigner from '../../components/product/MockTemplateDesigner.astro';
import MockRecordDetail from '../../components/product/MockRecordDetail.astro';
import MockVerification from '../../components/product/MockVerification.astro';
import MockEscalation from '../../components/product/MockEscalation.astro';
import MockAiSummary from '../../components/product/MockAiSummary.astro';
import MockDigest from '../../components/product/MockDigest.astro';
import MockAuditTrail from '../../components/product/MockAuditTrail.astro';
import { site, plans } from '../../data/site';

const starter = plans.find((p) => p.id === 'professional')!;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Obel MS Workflow Manager',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description: 'Nonconformance, change management, customer complaint, supplier deviation and action templates with staged approvals, effectiveness verification and a full audit trail.',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'ZAR',
    price: String(starter.price.ZAR),
    lowPrice: String(starter.price.ZAR),
    url: `${site.url}/pricing`,
  },
};
---
<BaseLayout
  title="CAPA and Nonconformance Software | Obel MS"
  description="Nonconformance, CAPA, change control and complaint workflows with approvals by job title, effectiveness checks and a full audit trail. Built for small teams."
  breadcrumbs={[{ name: 'Workflow Manager', href: '/product/workflow-manager' }]}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="pt-[calc(var(--nav-h)+clamp(3rem,8vw,6rem))] pb-4">
    <div class="container-x">
      <div class="max-w-3xl">
        <p class="label-dot">Workflow Manager <span class="pill pill-green ml-1">Live</span></p>
        <h1 class="t-hero mt-6 max-w-[16ch]" data-split data-split-load>Corrective actions that actually close.</h1>
        <p class="t-lead mt-6">
          Nonconformances, complaints, supplier deviations and change requests, each on a staged template with approvals, deadlines and an audit trail &mdash; not a spreadsheet someone forgets to update.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4" data-reveal>
          <a href="/contact#demo" class="btn btn-primary" data-magnetic>Book a demo</a>
          <a href="/pricing" class="btn btn-ghost">See pricing</a>
        </div>
      </div>
      <div class="mt-14 md:mt-16" data-reveal>
        <MockRecordsList />
      </div>
    </div>
  </section>

  <!-- Five templates -->
  <section class="section-y">
    <div class="container-x">
      <div class="max-w-xl mb-4" data-reveal>
        <p class="label-dot mb-4">Five templates, out of the box</p>
        <h2 class="t-h2">Built for a quality manager, not a generic ticket.</h2>
        <p class="t-body mt-4">Nonconformance, Change Management, Customer Complaint, Supplier Deviation and Action each ship with real stage-by-stage instructions, not placeholders.</p>
      </div>
      <MockTemplatesList />
    </div>
  </section>

  <!-- Signature moment: template designer -->
  <section class="section-y pt-0">
    <div class="container-x">
      <div class="max-w-xl mb-10" data-reveal>
        <p class="label-dot mb-4">The template designer</p>
        <h2 class="t-h2">Reorder stages, set deadlines, gate approvals.</h2>
        <p class="t-body mt-4">Drag a stage into a new position, give it a deadline, and decide whether it needs a named job title's approval before the record can advance.</p>
      </div>
      <MockTemplateDesigner />
    </div>
  </section>

  <!-- Record detail -->
  <section class="section-y pt-0">
    <div class="container-x">
      <FeatureRow label="Every record" title="One view: stage, owner, due date, history.">
        <Fragment slot="text">
          <p class="t-body">A record's meta strip shows exactly where it is &mdash; stage 3 of 6, who owns it, who's acting on it, and when it's due &mdash; with tabs for the full detail, the audit trail, the workflow and a PDF report.</p>
        </Fragment>
        <Fragment slot="mock"><MockRecordDetail /></Fragment>
      </FeatureRow>
    </div>
  </section>

  <!-- Effectiveness + escalation -->
  <section class="section-y pt-0">
    <div class="container-x space-y-16 lg:space-y-24">
      <FeatureRow label="Closing the loop" title="A corrective action isn't done until it works." reverse>
        <Fragment slot="text">
          <p class="t-body">Closing a nonconformance or supplier deviation schedules a verification check. Mark it Effective, or Mark Ineffective and reopen the loop.</p>
        </Fragment>
        <Fragment slot="mock"><MockVerification /></Fragment>
      </FeatureRow>

      <FeatureRow label="When a complaint is more" title="Escalate without starting over.">
        <Fragment slot="text">
          <p class="t-body">A Customer Complaint that turns out to be a product or supplier issue escalates straight into a Nonconformance or a Supplier Deviation, carrying its history with it.</p>
        </Fragment>
        <Fragment slot="mock"><MockEscalation /></Fragment>
      </FeatureRow>
    </div>
  </section>

  <!-- AI summaries -->
  <section class="section-y pt-0">
    <div class="container-x">
      <FeatureRow label="AI, kept honest" title="A draft summary, not a decision." reverse>
        <Fragment slot="text">
          <p class="t-body">Stage and executive summaries are drafted from what's recorded on the record, including attachments. Your team edits and approves before it goes into a report &mdash; Obel MS never signs anything on its own.</p>
        </Fragment>
        <Fragment slot="mock"><MockAiSummary /></Fragment>
      </FeatureRow>
    </div>
  </section>

  <!-- Notifications -->
  <section class="section-y pt-0">
    <div class="container-x">
      <FeatureRow label="Nothing goes quiet" title="Overdue is checked hourly, not once a week.">
        <Fragment slot="text">
          <p class="t-body">An hourly job checks every record against its due date. Overdue and assignment events go out by email and to Teams, so a stalled corrective action gets noticed the same day.</p>
        </Fragment>
        <Fragment slot="mock">
          <MockDigest
            emailSubject="Obel-MS | Workflow Manager | Overdue Records"
            emailLine="wf2609020011 is 2 days overdue at stage 2 of 3 (Investigation & Customer Response)."
            teamsTitle="QMS Alert: Overdue Records"
            teamsLine="Posted to your quality channel with the record code, stage and days overdue."
          />
        </Fragment>
      </FeatureRow>
    </div>
  </section>

  <!-- Reports -->
  <section class="section-y pt-0">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="label-dot mb-4">Reports</p>
        <h2 class="t-h2 max-w-[18ch]">See what's overdue, and whether the fixes worked.</h2>
        <p class="t-body mt-4">Every record has a PDF report. Under Reports, the quality dashboard shows CAPA timeliness, verification effectiveness, severity mix, sources and hotspots, and the leadership view tracks overdue stages over time.</p>
      </div>
    </div>
  </section>

  <!-- What auditors see -->
  <section class="section-y pt-0">
    <div class="container-x">
      <div class="grid lg:grid-cols-12 gap-x-10 gap-y-8 lg:items-center">
        <div class="lg:col-span-5">
          <p class="label-dot mb-4">What auditors see</p>
          <h2 class="t-h2 max-w-[16ch]">Every stage change, timestamped.</h2>
          <p class="t-body mt-4">Each entry reads as who did what and when &mdash; stage advances, approvals, attachments, verification &mdash; downloadable as a PDF for the audit file.</p>
        </div>
        <div class="lg:col-span-7">
          <MockAuditTrail />
        </div>
      </div>
    </div>
  </section>

  <RelatedGuides slugs={['capa-and-nonconformance', 'iso-9001-2026-changes', 'spreadsheets-vs-qms-software']} />
  <ProductCta
    title="Give corrective actions a place to close."
    body={`From R${starter.price.ZAR.toLocaleString('en-ZA')} a month excl. VAT, hosted in South Africa. We help you migrate your open registers.`}
  />
</BaseLayout>
