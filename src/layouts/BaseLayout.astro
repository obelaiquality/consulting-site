---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, checkout, jsonLdString } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Trail below Home, e.g. [{ name: 'Product', href: '/product/...' }]. Adds BreadcrumbList JSON-LD. */
  breadcrumbs?: { name: string; href: string }[];
  ogType?: 'website' | 'article';
}
const { title, description = site.description, ogImage = '/og.png', noindex = false, jsonLd, breadcrumbs, ogType = 'website' } = Astro.props;
const fullTitle = title ? (title.includes(site.name) || title.includes('Obel') ? title : `${title} | ${site.name}`) : `${site.name}: Hosted Document Control, Approvals and Audit Trail`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogUrl = new URL(ogImage, site.url).href;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.company,
  alternateName: 'Obel AI',
  url: site.url,
  email: site.email,
  logo: `${site.url}/favicon.png`,
  description: `${site.company} builds and hosts ${site.name}, hosted document control and workflow software for small and mid-sized teams in document-heavy industries.`,
  areaServed: site.areaServed,
  contactPoint: { '@type': 'ContactPoint', contactType: 'sales', email: site.email, availableLanguage: ['English'] },
  ...(site.sameAs.length ? { sameAs: site.sameAs } : {}),
};
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.url}/#website`,
  name: site.name,
  url: site.url,
  inLanguage: 'en-ZA',
  publisher: { '@id': `${site.url}/#organization` },
};
const crumbs = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', href: '/' }, ...breadcrumbs].map((b, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: b.name,
        item: new URL(b.href, site.url).href,
      })),
    }
  : null;
const ld = [org, webSite, ...(crumbs ? [crumbs] : []), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
/*
 * Content-Security-Policy as a <meta> tag: GitHub Pages cannot send headers. A meta CSP cannot carry
 * frame-ancestors, report-uri or HSTS; those need a CDN (see docs/CHECKOUT-CONTRACT.md §7 and the
 * security review). Third-party origins are added only when their feature is switched on.
 */
const paddle = checkout.enabled ? ['https://cdn.paddle.com', 'https://*.paddle.com'] : [];
const captcha = site.formCaptcha ? ['https://web3forms.com', 'https://js.hcaptcha.com', 'https://*.hcaptcha.com'] : [];
const statusOrigin = checkout.statusApi ? [new URL(checkout.statusApi).origin] : [];
const src = (...parts: string[]) => parts.join(' ');
const csp = [
  "default-src 'self'",
  `script-src ${src("'self'", ...paddle, ...captcha)}`,
  `style-src ${src("'self'", "'unsafe-inline'", ...paddle, ...captcha)}`,
  `img-src ${src("'self'", 'data:', ...paddle, ...captcha)}`,
  "font-src 'self'",
  `connect-src ${src("'self'", 'https://api.web3forms.com', ...statusOrigin, ...paddle, ...captcha)}`,
  `frame-src ${paddle.length || captcha.length ? src(...paddle, ...captcha) : "'none'"}`,
  "form-action 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  'upgrade-insecure-requests',
].join('; ');
---
<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="150x150" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#111110" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_ZA" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site summary" />
    <script type="application/ld+json" set:html={jsonLdString(ld)} />
    <!-- Mark JS early so reveal styles apply before paint; fail-safe shows content if the motion engine never boots. -->
    <!-- Before paint: pick the price currency and mark JS (src/pages/early.js.ts). A file, so the CSP needs no inline script. -->
    <script is:inline src="/early.js"></script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] btn btn-primary">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
